        "scripts/run_intent_j3_scale_cell.sh",
        "{python}",
        "0",
        "256",
        "2",
        "4",
        "0.001",
        "10",
        "1000"
      ],
      "gpus": 1,
      "walltime_minutes": 300,
      "min_gpu_memory_mb": 30000,
      "purpose": "Fresh matched 256-width control on the same snapshot and backend as the scale cells.",
      "expected_artifacts": [
