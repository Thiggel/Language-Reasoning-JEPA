{
  "schema_version": 2,
  "project": "intent_phrase",
  "round_id": "2026-07-18-j3-width-scale-lr-crosscheck-v1",
  "decision": "Test whether J3 capacity is now the limiting factor after the seed-stable 1e-3 optimization gain. Compare a fresh seed-0 256-width control with a 512-width model under the identical full-history J3 protocol, and cross-check the larger scale at 5e-4 versus 1e-3. Promote 512 only if its best rate improves strict success by at least 0.03 over the fresh 256 control while retaining finite losses, state_std >= 0.5, state effective rank >= 64, and non-regressed slack-two success; otherwise retain 256 and move to the supported grounded-objective combination screen. Treat a material reversal between the two 512 rates as scale-specific optimization sensitivity, not evidence against capacity.",
  "git_commit": "AUTO",
  "jobs": [
    {
      "id": "j3-width256-lr1e3-seed0-control-v1",
      "cluster": "Grete",
      "command": [
